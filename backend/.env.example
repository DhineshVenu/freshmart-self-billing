PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/supermarket_billing
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
CLIENT_URL=http://localhost:5173
DEFAULT_STORE_NAME=Fresh Mart
DEFAULT_STORE_CITY=
DEMO_ADMIN_PASSWORD=replace-with-a-unique-local-password
DEMO_WORKER_PASSWORD=replace-with-a-unique-local-password
# Optional Gmail SMTP: enable 2-Step Verification, then create an App Password.
# Use the full Gmail address for SMTP_USER and the generated 16-character value
# (without spaces) for SMTP_PASS. Never commit your real app password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-address@gmail.com
SMTP_PASS=your-16-character-app-password
SMTP_FROM="Fresh Mart <your-address@gmail.com>"
VISION_API_ENABLED=false
VISION_PROVIDER=
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
